package component

import (
	"strconv"

	"github.com/bornholm/xolo/internal/core/model"
	common "github.com/bornholm/xolo/internal/http/handler/webui/common/component"
	"github.com/bornholm/xolo/internal/http/handler/webui/templui/component/button"
	"github.com/bornholm/xolo/internal/http/handler/webui/templui/component/icon"
	"github.com/bornholm/xolo/internal/http/handler/webui/templui/component/table"
)

templ AlertsPage(vmodel AlertsPageVModel) {
	@common.AppLayout(vmodel.AppLayoutVModel, common.WithTitle("Alertes — "+vmodel.Org.Name())) {
		{{ slug := vmodel.Org.Slug() }}
		<div class="space-y-6">
			@common.PageHeader(common.PageHeaderProps{
				Title:    "Alertes",
				Subtitle: alertsSubtitle(vmodel),
			}) {
				@button.Button(button.Props{
					Size:  button.SizeSm,
					Class: "gap-1.5",
					Href:  viewedPath(common.BaseURLString(ctx, common.WithPath("/orgs/", slug, "/events/alerts/new")), vmodel.View),
				}) {
					@icon.Plus(icon.Props{Class: "size-3.5"})
					Nouvelle alerte
				}
			}
			<div class="mb-3.5">
				@EventsTabs(vmodel.Org, "alerts", vmodel.View)
			</div>
			@common.FlashToast(vmodel.Success, "L'alerte")
			@common.Section() {
				@table.Table() {
					@table.Header() {
						@table.Row() {
							@table.Head() {
								Nom 
							}
							@table.Head() {
								Portée 
							}
							@table.Head() {
								Requête 
							}
							@table.Head() {
								Condition 
							}
							@table.Head() {
								État 
							}
							@table.Head() {
								Activée 
							}
							@table.Head()
						}
					}
					@table.Body() {
						if len(vmodel.Alerts) == 0 {
							@table.Row() {
								@table.Cell(table.CellProps{Attributes: templ.Attributes{"colspan": "7"}, Class: "py-8 text-center text-sm text-muted-foreground"}) {
									Aucune alerte : créez-en une pour être prévenu quand un motif d'événements se répète.
								}
							}
						}
						for _, a := range vmodel.Alerts {
							@alertRow(slug, a, vmodel.View)
						}
					}
				}
			}
		</div>
	}
}

templ alertRow(slug string, a model.Alert, view string) {
	@table.Row() {
		@table.Cell(table.CellProps{Class: "font-medium"}) {
			{ a.Name() }
		}
		@table.Cell() {
			if a.Scope() == model.AlertScopePersonal {
				@common.Badge(common.ToneNeutral, "perso")
			} else {
				@common.Badge(common.ToneInfo, "org")
			}
		}
		@table.Cell(table.CellProps{Class: "font-mono text-xs max-w-xs truncate"}) {
			{ a.Query() }
		}
		@table.Cell(table.CellProps{Class: "text-xs whitespace-nowrap"}) {
			count({ a.Window().String() }) { " " }{ string(a.Comparator()) } { strconv.FormatFloat(a.Threshold(), 'f', -1, 64) }
		}
		@table.Cell() {
			@common.Badge(alertStateTone(a.State()), string(a.State()))
		}
		@table.Cell() {
			if a.Enabled() {
				@common.Badge(common.TonePositive, "oui")
			} else {
				@common.Badge(common.ToneNeutral, "non")
			}
		}
		@table.Cell(table.CellProps{Class: "text-right whitespace-nowrap"}) {
			<div class="flex gap-2 justify-end">
				@button.Button(button.Props{
					Variant:    button.VariantGhost,
					Size:       button.SizeIcon,
					Class:      "size-7",
					Href:       viewedPath(common.BaseURLString(ctx, common.WithPath("/orgs/", slug, "/events/alerts/", string(a.ID()), "/edit")), view),
					Attributes: templ.Attributes{"title": "Modifier"},
				}) {
					@icon.Pencil(icon.Props{Class: "size-3.5"})
				}
				@common.ConfirmDelete(common.ConfirmDeleteProps{
					URL:         viewedPath(common.BaseURLString(ctx, common.WithPath("/orgs/", slug, "/events/alerts/", string(a.ID()), "/delete")), view),
					Method:      "POST",
					Tooltip:     "Supprimer",
					Title:       "Supprimer cette alerte ?",
					Description: "Elle cessera de surveiller les événements et son historique de déclenchements sera perdu.",
				})
			</div>
		}
	}
}
