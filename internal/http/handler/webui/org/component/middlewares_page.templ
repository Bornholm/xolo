package component

import (
	"strconv"

	"github.com/bornholm/xolo/internal/core/model"
	"github.com/bornholm/xolo/internal/core/rbac"
	common "github.com/bornholm/xolo/internal/http/handler/webui/common/component"
	"github.com/bornholm/xolo/internal/http/handler/webui/templui/component/button"
	"github.com/bornholm/xolo/internal/http/handler/webui/templui/component/checkbox"
	"github.com/bornholm/xolo/internal/http/handler/webui/templui/component/icon"
	"github.com/bornholm/xolo/internal/http/handler/webui/templui/component/input"
	"github.com/bornholm/xolo/internal/http/handler/webui/templui/component/label"
	"github.com/bornholm/xolo/internal/http/handler/webui/templui/component/selectbox"
	switchcomp "github.com/bornholm/xolo/internal/http/handler/webui/templui/component/switch"
	"github.com/bornholm/xolo/internal/http/handler/webui/templui/component/textarea"
)

templ MiddlewaresPage(vmodel MiddlewaresPageVModel) {
	@common.AppLayout(vmodel.AppLayoutVModel, common.WithTitle("Middlewares — "+vmodel.Org.Name())) {
		@common.PageHeader(common.PageHeaderProps{
			Title:    "Middlewares",
			Subtitle: "Traitements appliqués dynamiquement aux requêtes, dans l'ordre de priorité croissante.",
		}) {
			if common.HasPermission(ctx, vmodel.Org.ID(), rbac.PermMiddlewaresWrite) {
				@button.Button(button.Props{
					Size:  button.SizeSm,
					Class: "gap-1.5",
					Href:  common.BaseURLString(ctx, common.WithPath("/orgs/", vmodel.Org.Slug(), "/admin/middlewares/new")),
				}) {
					@icon.Plus(icon.Props{Class: "size-3.5"})
					Nouveau middleware
				}
			}
		}
		@common.FlashToast(vmodel.Success, "Le middleware")
		@common.FlashError(vmodel.Error, "Un middleware")
		if len(vmodel.Middlewares) == 0 {
			@common.EmptyState(common.EmptyStateProps{
				Icon:        icon.Layers,
				Title:       "Aucun middleware",
				Description: "Un middleware s'intercale entre une requête et le modèle : contrôle horaire, filtrage, garde-fous.",
			}) {
				if common.HasPermission(ctx, vmodel.Org.ID(), rbac.PermMiddlewaresWrite) {
					@button.Button(button.Props{
						Size: button.SizeSm,
						Href: common.BaseURLString(ctx, common.WithPath("/orgs/", vmodel.Org.Slug(), "/admin/middlewares/new")),
					}) {
						Nouveau middleware
					}
				}
			}
		} else {
			<div class="flex flex-col gap-2">
				for _, mw := range vmodel.Middlewares {
					@middlewareRow(vmodel, mw)
				}
			</div>
			@common.SectionNote() {
				Plusieurs middlewares applicables au même modèle s'enchaînent par
				priorité croissante : le plus petit numéro s'exécute en premier, donc
				le plus à l'extérieur.
			}
		}
	}
}

// middlewareRow renders one middleware as the mockup's dense row: priority,
// identity, scope, then the enable switch and the pipeline shortcut.
templ middlewareRow(vmodel MiddlewaresPageVModel, mw model.Middleware) {
	{{ writable := common.HasPermission(ctx, vmodel.Org.ID(), rbac.PermMiddlewaresWrite) }}
	<div class={ "flex flex-wrap items-center gap-3 rounded-lg border bg-card px-3.5 py-2.5", templ.KV("opacity-60", !mw.Enabled()) }>
		<span class="w-6 shrink-0 text-right font-mono text-xs text-muted-foreground" title="Priorité">
			{ strconv.Itoa(mw.Priority()) }
		</span>
		@common.IconSquare(icon.Layers, middlewareTintClass(mw))
		<div class="min-w-0 flex-1">
			<div class="flex flex-wrap items-center gap-2">
				<span class="text-sm font-semibold">{ mw.Name() }</span>
				if plugin := middlewarePluginName(mw); plugin != "" {
					@common.Mono(plugin)
				}
			</div>
			if mw.Description() != "" {
				<div class="mt-0.5 text-xs text-muted-foreground">{ mw.Description() }</div>
			}
		</div>
		<span class="shrink-0">
			if mw.AppliesToAll() {
				@common.Badge(common.ToneInfo, "tous les modèles")
			} else {
				@common.Badge(common.ToneNeutral, Pluralize(len(mw.Targets()), "modèle", "modèles"))
			}
		</span>
		<div class="w-24 shrink-0 text-right">
			// TODO(rework-ux): la maquette compte les déclenchements par middleware.
			// L'exécution d'un pipeline n'émet pas encore d'événement compté par
			// entité (cf. lot 7 du plan).
			@common.PendingValue("Les déclenchements ne sont pas encore comptés.")
			<div class="text-2xs text-muted-foreground">déclenchements</div>
		</div>
		<div class="flex shrink-0 items-center gap-2">
			@middlewareToggle(vmodel, mw, writable)
			if common.HasPermission(ctx, vmodel.Org.ID(), rbac.PermMiddlewaresRead) {
				@button.Button(button.Props{
					Href:    common.BaseURLString(ctx, common.WithPath("/orgs/", vmodel.Org.Slug(), "/admin/middlewares/", string(mw.ID()), "/pipeline")),
					Variant: button.VariantOutline,
					Size:    button.SizeSm,
				}) {
					Pipeline
				}
			}
			if writable {
				@button.Button(button.Props{
					Href:       common.BaseURLString(ctx, common.WithPath("/orgs/", vmodel.Org.Slug(), "/admin/middlewares/", string(mw.ID()), "/edit")),
					Variant:    button.VariantGhost,
					Size:       button.SizeIcon,
					Class:      "size-7",
					Attributes: templ.Attributes{"title": "Modifier"},
				}) {
					@icon.Pencil(icon.Props{Class: "size-3.5"})
				}
				@common.ConfirmDelete(common.ConfirmDeleteProps{
					URL:         common.BaseURLString(ctx, common.WithPath("/orgs/", vmodel.Org.Slug(), "/admin/middlewares/", string(mw.ID()))),
					Tooltip:     "Supprimer",
					Title:       "Supprimer ce middleware ?",
					Description: "Il sera retiré du pipeline de toutes les requêtes qui le traversaient.",
				})
			}
		</div>
	</div>
}

// middlewareToggle renders the enable switch of a row.
//
// It posts to the edit endpoint the form page already uses, so toggling from the
// list goes through the same validation as toggling from the editor; the switch
// submits its own form to keep the row a link-and-form area rather than a script.
templ middlewareToggle(vmodel MiddlewaresPageVModel, mw model.Middleware, writable bool) {
	if writable {
		<form
			method="POST"
			action={ templ.SafeURL(common.BaseURLString(ctx, common.WithPath("/orgs/", vmodel.Org.Slug(), "/admin/middlewares/", string(mw.ID()), "/toggle"))) }
			class="flex items-center"
		>
			@switchcomp.Switch(switchcomp.Props{
				ID:      "enabled-" + string(mw.ID()),
				Name:    "enabled",
				Value:   "1",
				Checked: mw.Enabled(),
				Attributes: templ.Attributes{
					"data-xolo-submit-on-change": true,
					"title":                      middlewareToggleTitle(mw),
				},
			})
		</form>
	} else {
		if mw.Enabled() {
			@common.Badge(common.TonePositive, "Activé")
		} else {
			@common.Badge(common.ToneNeutral, "Désactivé")
		}
	}
}

templ MiddlewareFormPage(vmodel MiddlewareFormVModel) {
	{{ title := "Nouveau middleware" }}
	{{ action := common.BaseURLString(ctx, common.WithPath("/orgs/", vmodel.Org.Slug(), "/admin/middlewares")) }}
	if !vmodel.IsNew {
		{{ title = "Modifier le middleware" }}
		{{ action = common.BaseURLString(ctx, common.WithPath("/orgs/", vmodel.Org.Slug(), "/admin/middlewares/", string(vmodel.Middleware.ID()), "/edit")) }}
	}
	@common.AppLayout(vmodel.AppLayoutVModel, common.WithTitle(title)) {
		<div class="space-y-6 max-w-2xl">
			@common.PageHeader(common.PageHeaderProps{
				Title: title,
			})
			@common.FlashError(vmodel.Error, "Un middleware")
			<form method="POST" action={ templ.SafeURL(action) } class="space-y-5">
				<div class="space-y-2">
					@label.Label(label.Props{For: "name"}) {
						Nom
					}
					@input.Input(input.Props{
						ID:          "name",
						Name:        "name",
						Value:       vmodel.Name,
						Placeholder: "ex: contrôle horaire",
						Attributes:  templ.Attributes{"required": true},
					})
				</div>
				<div class="space-y-2">
					@label.Label(label.Props{For: "description"}) {
						Description
					}
					@textarea.Textarea(textarea.Props{ID: "description", Name: "description", Rows: 2, Value: vmodel.Description})
				</div>
				if !vmodel.IsNew {
					<div class="flex items-center gap-2">
						@checkbox.Checkbox(checkbox.Props{ID: "enabled", Name: "enabled", Value: "1", Checked: vmodel.Enabled})
						@label.Label(label.Props{For: "enabled"}) {
							Activé
						}
					</div>
					<div class="space-y-2">
						@label.Label(label.Props{For: "priority"}) {
							Priorité
						}
						@input.Input(input.Props{
							ID:    "priority",
							Name:  "priority",
							Type:  input.TypeNumber,
							Value: strconv.Itoa(vmodel.Priority),
						})
						<p class="text-sm text-muted-foreground">Ordre d'application lorsque plusieurs middlewares ciblent le même modèle (plus petit = appliqué en premier / plus externe).</p>
					</div>
					<div class="space-y-3 rounded-lg border p-4">
						<div class="flex items-center gap-2">
							@checkbox.Checkbox(checkbox.Props{ID: "applies_to_all", Name: "applies_to_all", Value: "1", Checked: vmodel.AppliesToAll})
							@label.Label(label.Props{For: "applies_to_all"}) {
								Appliquer à tous les modèles de l'organisation
							}
						</div>
						<p class="text-sm text-muted-foreground">Sinon, sélectionnez les modèles ciblés ci-dessous.</p>
						if len(vmodel.Options) == 0 {
							<p class="text-sm text-muted-foreground">Aucun modèle disponible dans cette organisation.</p>
						} else {
							@selectbox.SelectBox() {
								@selectbox.Trigger(selectbox.TriggerProps{
									Name:              "targets",
									Multiple:          true,
									ShowPills:         true,
									SelectedCountText: "modèle(s) sélectionné(s)",
								}) {
									@selectbox.Value(selectbox.ValueProps{Placeholder: "Sélectionner des modèles…", Multiple: true})
								}
								@selectbox.Content(selectbox.ContentProps{SearchPlaceholder: "Rechercher un modèle…"}) {
									for _, opt := range vmodel.Options {
										{{ key := TargetKey(opt.Kind, opt.ID) }}
										@selectbox.Item(selectbox.ItemProps{Value: key, Selected: vmodel.Selected[key]}) {
											{ opt.Label }
										}
									}
								}
							}
						}
					</div>
				}
				<div class="flex gap-2">
					@button.Button(button.Props{Type: button.TypeSubmit}) {
						Enregistrer
					}
					@button.Button(button.Props{
						Href:    common.BaseURLString(ctx, common.WithPath("/orgs/", vmodel.Org.Slug(), "/admin/middlewares")),
						Variant: button.VariantOutline,
					}) {
						Annuler
					}
				</div>
			</form>
			if !vmodel.IsNew {
				<div class="rounded-lg border p-4 flex items-center justify-between">
					<div>
						<div class="font-medium">Pipeline</div>
						<div class="text-sm text-muted-foreground">Configurez le traitement appliqué (insérez un nœud plugin entre la requête et le modèle).</div>
					</div>
					@button.Button(button.Props{
						Href:    common.BaseURLString(ctx, common.WithPath("/orgs/", vmodel.Org.Slug(), "/admin/middlewares/", string(vmodel.Middleware.ID()), "/pipeline")),
						Variant: button.VariantOutline,
					}) {
						@icon.Workflow(icon.Props{Size: 14, Class: "mr-2"})
						Configurer le pipeline
					}
				</div>
			}
		</div>
	}
}
