package component

import (
	"strconv"

	"github.com/bornholm/xolo/internal/core/model"
	"github.com/bornholm/xolo/internal/core/rbac"
	common "github.com/bornholm/xolo/internal/http/handler/webui/common/component"
	"github.com/bornholm/xolo/internal/http/handler/webui/templui/component/button"
	"github.com/bornholm/xolo/internal/http/handler/webui/templui/component/icon"
)

// ── Providers Page ────────────────────────────────────────────────────────────
templ ProvidersPage(vmodel ProvidersPageVModel) {
	@common.AppLayout(vmodel.AppLayoutVModel, common.WithTitle("Fournisseurs — "+vmodel.Org.Name())) {
		@common.PageHeader(common.PageHeaderProps{
			Title:    "Fournisseurs",
			Subtitle: "Endpoints LLM amont déclarés pour " + vmodel.Org.Name() + " et modèles exposés par chacun.",
		}) {
			if common.HasPermission(ctx, vmodel.Org.ID(), rbac.PermProvidersWrite) {
				@button.Button(button.Props{
					Size:  button.SizeSm,
					Class: "gap-1.5",
					Href:  common.BaseURLString(ctx, common.WithPath("/orgs/", vmodel.Org.Slug(), "/admin/providers/new")),
				}) {
					@icon.Plus(icon.Props{Class: "size-3.5"})
					Ajouter un fournisseur
				}
			}
		}
		if vmodel.Success != "" {
			<div class="mb-3.5">
				@common.InfoBanner(common.TonePositive, "Opération réussie.")
			</div>
		}
		if len(vmodel.Providers) == 0 {
			@common.EmptyState(common.EmptyStateProps{
				Icon:        icon.Server,
				Title:       "Aucun fournisseur",
				Description: "Un fournisseur est un endpoint LLM amont. Ajoutez-en un pour que l'organisation puisse appeler des modèles.",
			}) {
				if common.HasPermission(ctx, vmodel.Org.ID(), rbac.PermProvidersWrite) {
					@button.Button(button.Props{
						Size: button.SizeSm,
						Href: common.BaseURLString(ctx, common.WithPath("/orgs/", vmodel.Org.Slug(), "/admin/providers/new")),
					}) {
						Ajouter un fournisseur
					}
				}
			}
		} else {
			<div class="flex flex-col gap-2.5">
				for _, p := range vmodel.Providers {
					@providerRow(vmodel, p)
				}
			</div>
		}
	}
}

// providerRow renders one provider as the mockup's framed row: identity on the
// left, the figures strip in the middle, the actions on the right, and — for a
// subscription provider — a footer carrying the plan.
templ providerRow(vmodel ProvidersPageVModel, p model.Provider) {
	@common.Section() {
		@common.SectionBody(common.SectionBodyProps{Class: "flex flex-wrap items-center gap-3.5"}) {
			@common.IconSquare(icon.Server, providerTintClass(p))
			<div class="min-w-0 flex-1">
				<div class="flex flex-wrap items-center gap-2">
					<span class="text-sm font-semibold">{ p.Name() }</span>
					if p.Active() {
						@common.Badge(common.TonePositive, "actif")
					} else {
						@common.Badge(common.ToneNeutral, "inactif")
					}
					@common.Badge(common.ToneNeutral, p.Type())
					if p.BillingMode() == model.BillingModeSubscription {
						@common.Badge(common.ToneInfo, "abonnement")
					}
				</div>
				@common.Mono(p.BaseURL())
			</div>
			<div class="flex shrink-0 flex-wrap items-start gap-5.5">
				@common.InlineStat("Modèles", common.ToneNeutral) {
					{ strconv.Itoa(vmodel.ModelCounts[p.ID()]) }
				}
				// TODO(rework-ux): la maquette affiche coût 30 j, p95 et taux
				// d'erreur par fournisseur. Aucun agrégat d'usage n'est indexé par
				// ProviderID côté domaine (port.UsageStore agrège par modèle), donc
				// les colonnes gardent leur place sans inventer de chiffre.
				@common.InlineStat("Coût 30 j", common.ToneNeutral) {
					@common.PendingValue("Le coût n'est pas encore agrégé par fournisseur.")
				}
				@common.InlineStat("p95", common.ToneNeutral) {
					@common.PendingValue("La latence amont n'est pas encore mesurée.")
				}
				@common.InlineStat("Erreurs", common.ToneNeutral) {
					@common.PendingValue("Le taux d'erreur amont n'est pas encore mesuré.")
				}
			</div>
			<div class="flex shrink-0 items-center gap-1">
				@button.Button(button.Props{
					Href:    common.BaseURLString(ctx, common.WithPath("/orgs/", vmodel.Org.Slug(), "/admin/providers/", string(p.ID()), "/models")),
					Variant: button.VariantOutline,
					Size:    button.SizeSm,
				}) {
					Modèles
				}
				if common.HasPermission(ctx, vmodel.Org.ID(), rbac.PermProvidersWrite) {
					@button.Button(button.Props{
						Href:    common.BaseURLString(ctx, common.WithPath("/orgs/", vmodel.Org.Slug(), "/admin/providers/", string(p.ID()), "/edit")),
						Variant: button.VariantOutline,
						Size:    button.SizeSm,
					}) {
						Configurer
					}
					@common.ConfirmDelete(common.ConfirmDeleteProps{
						URL:         common.BaseURLString(ctx, common.WithPath("/orgs/", vmodel.Org.Slug(), "/admin/providers/", string(p.ID()))),
						Tooltip:     "Supprimer",
						Title:       "Supprimer ce fournisseur ?",
						Description: "Les modèles qu'il expose disparaîtront avec lui et ne seront plus servis.",
					})
				}
			</div>
		}
		if plan := p.SubscriptionPlan(); plan != nil && plan.Label != "" {
			<div class="flex flex-wrap items-center gap-2.5 border-t bg-row-hover px-4 py-2">
				<span class="text-xs text-muted-foreground">Forfait { plan.Label }</span>
				// TODO(rework-ux): la maquette montre ici la jauge de consommation
				// du forfait. Elle demande un rapprochement usage ↔ contraintes de
				// plan qui n'existe pas encore (cf. lot 7 du plan).
				@common.PendingValue("La consommation du forfait n'est pas encore rapprochée.")
			</div>
		}
	}
}

// providerTintClass returns the tint of a provider's icon square: the semantic
// colour of an inactive provider is the muted one, so a disabled endpoint reads
// as switched off before the pill is even read.
func providerTintClass(p model.Provider) string {
	if !p.Active() {
		return "bg-muted text-muted-foreground"
	}
	return "bg-primary-tint text-primary"
}
