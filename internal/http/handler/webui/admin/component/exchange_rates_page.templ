package component

import (
	"fmt"

	"github.com/xolo-gateway/xolo/internal/core/model"
	commonComp "github.com/xolo-gateway/xolo/internal/http/handler/webui/common/component"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/button"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/icon"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/table"
)

type ExchangeRatesPageVModel struct {
	AppLayoutVModel commonComp.AppLayoutVModel
	Rates           []model.ExchangeRate
}

templ ExchangeRatesPage(vmodel ExchangeRatesPageVModel) {
	@commonComp.AppLayout(vmodel.AppLayoutVModel, commonComp.WithTitle("Taux de change")) {
		<div class="max-w-4xl">
			@commonComp.PageHeader(commonComp.PageHeaderProps{
				Title:    "Taux de change",
				Subtitle: "Données en cache, rafraîchies automatiquement. Elles convertissent les coûts des fournisseurs vers la devise de chaque organisation.",
			})
			<div class="mb-3.5">
				@commonComp.InfoBanner(commonComp.ToneInfo, lastSyncMessage(vmodel.Rates)) {
					<!-- TODO(rework-ux): le rafraîchissement est piloté par
					ExchangeRateService.StartRefresher, sur une minuterie. Aucune
					route ne le déclenche à la demande ; le bouton de la maquette
					reste donc inerte (cf. lot 7 du plan). -->
					@button.Button(button.Props{
						Variant:  button.VariantOutline,
						Size:     button.SizeSm,
						Disabled: true,
						Class:    "ml-auto gap-1.5 bg-card",
					}) {
						@icon.RefreshCw(icon.Props{Class: "size-3.5"})
						Synchroniser
					}
				}
			</div>
			if len(vmodel.Rates) == 0 {
				@commonComp.EmptyState(commonComp.EmptyStateProps{
					Icon:        icon.RefreshCw,
					Title:       "Aucun taux en cache",
					Description: "Le rafraîchissement automatique peuplera cette table au prochain cycle. Tant qu'elle est vide, les coûts sont affichés dans la devise du fournisseur.",
				})
			} else {
				@commonComp.Section() {
					@table.Table() {
						@table.Header() {
							@table.Head() {
								De
							}
							@table.Head() {
								Vers
							}
							@table.Head(table.HeadProps{Class: "text-right"}) {
								Taux
							}
							@table.Head() {
								Mis à jour le
							}
						}
						@table.Body() {
							for _, rate := range vmodel.Rates {
								@table.Row() {
									@table.Cell(table.CellProps{Class: "font-mono text-sm font-semibold"}) {
										{ rate.FromCurrency }
									}
									@table.Cell(table.CellProps{Class: "font-mono text-sm font-semibold"}) {
										{ rate.ToCurrency }
									}
									@table.Cell(table.CellProps{Class: "text-right text-sm"}) {
										{ fmt.Sprintf("%.8g", rate.Rate) }
									}
									@table.Cell() {
										@commonComp.Mono(rate.FetchedAt.Format("02/01/2006 15:04:05"))
									}
								}
							}
						}
					}
				}
			}
		</div>
	}
}
