package component

import "github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/skeleton"

// LoadingIndicator marks the placeholder shown while an HTMX request is in
// flight. `htmx-indicator` is htmx's own convention: it ships the rule that
// keeps the element at opacity 0 until an enclosing request adds
// `htmx-request`, so nothing has to be declared in templui.css.
//
// Wrap it around skeletons and put it inside the target region:
//
//	<div id="usage-chart">
//	  @common.LoadingIndicator() {
//	    @common.SkeletonBlock()
//	  }
//	  … contenu rendu par le serveur …
//	</div>
templ LoadingIndicator() {
	<div class="htmx-indicator" aria-hidden="true">
		{ children... }
	</div>
}

// SkeletonRows renders `rows` placeholder lines, for a region that will be
// filled with a table or a list.
templ SkeletonRows(rows int) {
	<div class="space-y-2">
		for range rows {
			@skeleton.Skeleton(skeleton.Props{Class: "h-9 w-full"})
		}
	</div>
}

// SkeletonBlock renders a placeholder for a chart or a card body.
templ SkeletonBlock() {
	<div class="space-y-3">
		@skeleton.Skeleton(skeleton.Props{Class: "h-4 w-1/3"})
		@skeleton.Skeleton(skeleton.Props{Class: "h-40 w-full"})
	</div>
}
